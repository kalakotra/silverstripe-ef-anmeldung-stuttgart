{
    "name": "kalakotra/silverstripe-ef-anmeldung-stuttgart",
    "description": "Anmeldung Stuttgart (Meldeschein 32/42-0034) - form module for the e-formulare.de PDF filler (requires the pdf-editor app base classes).",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "pdf",
        "e-formulare",
        "anmeldung",
        "stuttgart",
        "meldeschein"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/multiform": "^3.0@dev",
        "unclecheese/display-logic": "^4.0",
        "mikehaertl/php-pdftk": "^0.14",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Kalakotra\\EFormAnmeldungStuttgart\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
